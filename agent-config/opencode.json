{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11435/v1"
      },
      "models": {
          "qwen3.6-32k": {
              "name": "qwen3.6-32k",
              "tool_call": true
          }
      }
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
        "command": ["npx", "-y", "mcp-searxng"],
        "environment": {
            "SEARXNG_URL": "http://localhost:8090"
        },
        "enabled": true
    },
    "comm-tools": {
        "type": "local",
        "command": ["python3", "/home/npalmass/work/OpenCode/claude-files/comm-tools/comm_tools_mcp.py"],
        "environment": {
            "COMM_TOOLS_MODE": "mock"
        },
        "enabled": true
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11435/v1"
      },
      "models": {
          "qwen2.5:14b-instruct": {
              "name": "qwen2.5:14b-instruct",
	      "tool_call": true
          }
      }
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
	"command": ["npx", "-y", "mcp-searxng"],
	"environment": {
	    "SEARXNG_URL": "http://localhost:8090"
	},
	"enabled": true
    }
  }
}
